# Frontend — Node / Vite
# ============================================================
node_modules/
build/
dist/
dist-ssr/
.vite/
*.local

# Generated Tailwind CSS output (rebuilt by `npm run dev`)
src/output.css

# npm/yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# Environment & Secrets — NEVER commit real keys
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Python — Backend & ML notebooks
# ============================================================

# Virtual environments (includes the misnamed backend/# and backend/Create dirs)
venv/
.venv/
env/
backend/venv/
backend/#/
backend/Create/
backendML/venv/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Distribution / packaging
*.egg-info/
*.egg
.eggs/

# Type checking & test caches
.mypy_cache/
.pytest_cache/
.benchmarks/
.ruff_cache/
.hypothesis/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ============================================================
# ML Models — large binaries (500 MB+ total), use cloud storage / DVC
# ============================================================
*.pkl
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.joblib

# ============================================================
# Jupyter — ignore only auto-save checkpoints, keep .ipynb
# ============================================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ============================================================
# IDEs & Editors
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# VS Code extension installers
*.vsix

